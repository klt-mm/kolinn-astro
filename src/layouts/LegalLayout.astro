---
import BaseLayout from './BaseLayout.astro';
interface Props {
  title: string;
}
const { title } = Astro.props;
---

<BaseLayout title={title}>
  <main id="main" class="legal-container" tabindex="-1">
    <header class="legal-header">
      <h1>{title}</h1>
      <p class="last-updated">Last updated: October 2026</p>
    </header>
    <div class="legal-content">
      <slot />
    </div>
  </main>
  <footer class="legal-footer">
    <div class="container">
      <a href="/" class="back-link">&larr; Back to home</a>
    </div>
  </footer>
</BaseLayout>

<style>
  .legal-container {
    max-width: var(--kds-container-max);
    margin: 0 auto;
    padding: var(--kds-space-8) var(--kds-gutter);
    min-height: calc(100dvh - var(--kds-nav-height));
    display: flex;
    flex-direction: column;
  }

  .legal-header {
    margin-bottom: var(--kds-space-8);
    border-bottom: 1px solid var(--kds-border-default);
    padding-bottom: var(--kds-space-4);
  }

  .legal-header h1 {
    font-size: var(--kds-heading-32);
    line-height: var(--kds-lh-heading-32);
    color: var(--kds-text-primary);
    margin-bottom: var(--kds-space-2);
  }

  .last-updated {
    font-size: var(--kds-small-14);
    color: var(--kds-text-muted);
    font-family: var(--kds-font-mono);
  }

  .legal-content {
    line-height: var(--kds-lh-body-16);
    color: var(--kds-text-body);
    font-size: var(--kds-body-16);
    flex: 1;
  }

  .legal-content h2 {
    font-size: var(--kds-heading-24);
    line-height: var(--kds-lh-heading-24);
    color: var(--kds-text-primary);
    margin: var(--kds-space-8) 0 var(--kds-space-3);
    padding-left: var(--kds-space-3);
    border-left: 3px solid var(--kds-action-primary);
  }

  .legal-content p {
    margin-bottom: var(--kds-space-4);
  }

  .legal-content ul {
    margin-bottom: var(--kds-space-4);
    padding-left: var(--kds-space-4);
  }

  .legal-content h2:first-child {
    margin-top: 0;
  }

  .legal-footer {
    padding: var(--kds-space-8) 0;
    border-top: 1px solid var(--kds-border-default);
    margin-top: var(--kds-space-8);
  }

  .back-link {
    font-family: var(--kds-font-mono);
    font-size: var(--kds-small-14);
    color: var(--kds-text-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-link:hover {
    color: var(--kds-action-primary);
  }
</style>
