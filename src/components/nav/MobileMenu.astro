---
/**
 * MobileMenu — full-height navigation sheet (< 769px).
 *
 * inert + aria-hidden at rest. Opening makes the dialog modal, contains
 * focus, and locks body scroll. Accordions are single-open; closing
 * restores focus to the hamburger trigger.
 */
import SearchField from '../ui/SearchField.astro';
import MobileAccordion from './MobileAccordion.astro';
import Button from '../ui/Button.astro';
import { mobileSections } from '../../data/navigation';
import { site } from '../../config/site';
---

<div class="mobile-menu" id="mobileMenu" aria-hidden="true" inert>
  <div class="mobile-menu-content" id="mobileMenuContent">
    <div class="container">
      <SearchField id="mobileSearchInput" class="mobile-search-field" />

      <nav aria-label="Mobile navigation">
        {
          mobileSections.map((section) => (
            <MobileAccordion label={section.label} links={section.links} />
          ))
        }
      </nav>

      <Button href={site.cta.href} variant="primary" class="mobile-cta">{site.cta.label}</Button>
    </div>
  </div>
</div>

<script>
  /* =========================================================
     KOLINN_NAV behavior — mobile sheet + accordions
     (script.js §3 accordion, §4 open/close, §5 mobile half).
     Class-driven state; inert-based focus containment.
     ========================================================= */
  const mobileToggle = document.getElementById('mobileMenuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const mobileContent = document.getElementById('mobileMenuContent');
  const globalNav = document.getElementById('globalNav');
  const mobileNavigation = document.getElementById('mobileNavigation');
  const menuCurtain = document.getElementById('menuCurtain');

  const desktopMQ = window.matchMedia('(min-width: 769px)');

  let isMobileMenuOpen = false;
  const backgroundInertState = new Map<HTMLElement, boolean>();

  if (mobileToggle && mobileMenu && mobileContent && globalNav) {
    /* ---------- 3. MOBILE ACCORDION MENU ---------- */
    const mobileAccordionHeaders = Array.from(
      document.querySelectorAll<HTMLElement>('.mobile-accordion-header')
    );
    mobileAccordionHeaders.forEach((header) => {
      header.addEventListener('click', () => {
        const willOpen = header.getAttribute('aria-expanded') !== 'true';
        const inner = header.nextElementSibling?.querySelector<HTMLElement>('.mobile-accordion-inner') ?? null;

        mobileContent
          .querySelectorAll<HTMLElement>('.mobile-accordion-header[aria-expanded="true"]')
          .forEach((openHeader) => {
            if (openHeader === header) return;
            openHeader.setAttribute('aria-expanded', 'false');
            const openInner = openHeader.nextElementSibling?.querySelector<HTMLElement>('.mobile-accordion-inner');
            if (openInner) openInner.classList.remove('is-animating');
          });

        header.setAttribute('aria-expanded', String(willOpen));

        if (inner) {
          inner.classList.remove('is-animating');
          if (willOpen) {
            void inner.offsetHeight;
            inner.classList.add('is-animating');
          }
        }
      });
    });

    /* ---------- 4. MOBILE MENU OPEN/CLOSE ---------- */
    function setMobileMenu(open: boolean) {
      isMobileMenuOpen = open;
      mobileToggle!.setAttribute('aria-expanded', String(open));
      mobileToggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      mobileMenu!.classList.toggle('is-open', open);
      globalNav?.classList.toggle('is-mobile-menu-open', open);
      mobileMenu!.inert = !open;
      mobileMenu!.setAttribute('aria-hidden', String(!open));

      if (open) {
        mobileNavigation?.setAttribute('role', 'dialog');
        mobileNavigation?.setAttribute('aria-modal', 'true');
        mobileNavigation?.setAttribute('aria-label', 'Mobile navigation');
        mobileNavigation?.setAttribute('aria-hidden', 'false');

        Array.from(document.body.children).forEach((child) => {
          if (!(child instanceof HTMLElement)) return;
          const isPageBackground = child.id === 'skip-link' ||
            child.id === 'nav-status' ||
            child.tagName === 'MAIN' ||
            child.classList.contains('site-footer');
          if (!isPageBackground) return;
          backgroundInertState.set(child, child.inert);
          child.inert = true;
        });
        if (menuCurtain) {
          backgroundInertState.set(menuCurtain, menuCurtain.inert);
          menuCurtain.inert = true;
        }
        const navContent = globalNav!.querySelector<HTMLElement>('.nav-content');
        if (navContent) {
          Array.from(navContent.children).forEach((child) => {
            if (!(child instanceof HTMLElement)) return;
            if (!child.contains(mobileToggle)) {
              backgroundInertState.set(child, child.inert);
              child.inert = true;
              return;
            }

            Array.from(child.children).forEach((action) => {
              if (!(action instanceof HTMLElement)) return;
              if (action !== mobileToggle && !action.contains(mobileToggle)) {
                backgroundInertState.set(action, action.inert);
                action.inert = true;
              }
            });
          });
        }
        Array.from(globalNav!.children).forEach((child) => {
          if (!(child instanceof HTMLElement) || child === navContent) return;
          backgroundInertState.set(child, child.inert);
          child.inert = true;
        });
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        if (scrollbarWidth > 0) document.body.style.paddingRight = `${scrollbarWidth}px`;
        document.body.style.overflow = 'hidden';
        window.setTimeout(() => {
          if (isMobileMenuOpen) {
            document.getElementById('mobileSearchInput')?.focus();
          }
        }, 50);
      } else {
        mobileNavigation?.removeAttribute('role');
        mobileNavigation?.removeAttribute('aria-modal');
        mobileNavigation?.removeAttribute('aria-label');
        mobileNavigation?.removeAttribute('aria-hidden');

        backgroundInertState.forEach((wasInert, element) => {
          element.inert = wasInert;
        });
        backgroundInertState.clear();
        document.body.style.overflow = '';
        document.body.style.paddingRight = '';
      }
    }

    const restoreToggleFocus = () => {
      if (!desktopMQ.matches && !mobileToggle.closest('[inert]')) mobileToggle.focus();
    };

    mobileToggle.addEventListener('click', () => {
      const open = !isMobileMenuOpen;
      setMobileMenu(open);
      if (!open) restoreToggleFocus();
    });

    mobileContent.addEventListener('click', (event) => {
      const link = (event.target as HTMLElement).closest('a[href]');
      if (!link) return;
      setMobileMenu(false);
    });

    /* ---------- 5. GLOBAL BEHAVIOR (mobile half) ---------- */
    document.addEventListener('keydown', (event) => {
      if (!isMobileMenuOpen) return;

      if (event.key === 'Escape') {
        setMobileMenu(false);
        restoreToggleFocus();
        return;
      }

      if (event.key !== 'Tab' || !mobileMenu) return;

      const focusScope = mobileNavigation ?? mobileMenu;
      const focusable = Array.from(
        focusScope.querySelectorAll<HTMLElement>(
          'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])'
        )
      ).filter((element) =>
        element.getClientRects().length > 0 &&
        getComputedStyle(element).visibility !== 'hidden' &&
        !element.closest('[inert]')
      );
      const first = focusable[0] ?? mobileToggle;
      const last = focusable[focusable.length - 1] ?? mobileToggle;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      } else if (!focusable.length && document.activeElement !== mobileToggle) {
        event.preventDefault();
        mobileToggle.focus();
      }
    });

    desktopMQ.addEventListener('change', () => {
      if (isMobileMenuOpen) {
        setMobileMenu(false);
        globalNav?.querySelector<HTMLElement>('[data-target]')?.focus();
      }
    });
  }
</script>
