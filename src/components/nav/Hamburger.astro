---
/**
 * Hamburger — mobile sheet trigger. The three lines morph into an ✕
 * purely from [aria-expanded="true"] (see nav-actions.css).
 */
---

<button
  class="hamburger"
  id="mobileMenuToggle"
  aria-expanded="false"
  aria-controls="mobileMenu"
  aria-label="Open menu"
>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
  <span class="hamburger-line"></span>
</button>
