---
/**
 * IconMonitor — "auto / system theme" glyph (24×24 stroke grid).
 * Shown while data-theme="auto" (see nav-actions.css).
 */
const { class: className } = Astro.props;
---

<svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
  <rect x="2" y="3" width="20" height="14" rx="2"></rect>
  <path d="M8 21h8M12 17v4"></path>
</svg>
