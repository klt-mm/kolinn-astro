---
/**
 * IconChevron — down chevron (24×24 stroke grid).
 * Rotates 180° when its accordion header is aria-expanded (mobile-menu.css).
 */
const { class: className } = Astro.props;
---

<svg class={className} aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
  <polyline points="6 9 12 15 18 9"></polyline>
</svg>
