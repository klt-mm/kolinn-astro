---
/**
 * Footer — system footer (role="contentinfo"): brand mark, nav echo
 * and a professional copyright line.
 */
import { footerLinks } from '../data/navigation';
import { site } from '../config/site';
---

<footer class="site-footer" role="contentinfo">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-brand-link" aria-label={`${site.brand} home`}>
        <span aria-hidden="true">&gt;_</span>
        <span>{site.brand}</span>
      </a>
    </div>
    <nav aria-label="Footer navigation">
      <div class="footer-nav-grid">
        {
          footerLinks.map((col) => (
            <div class="footer-nav-col">
              <h3 class="footer-nav-title">{col.title}</h3>
              <ul class="footer-links">
                {
                  col.links.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))
                }
              </ul>
            </div>
          ))
        }
      </div>
    </nav>
    <div class="footer-copyright">
      <p>&copy; {new Date().getFullYear()} {site.brand}. All rights reserved.</p>
    </div>
  </div>
</footer>
