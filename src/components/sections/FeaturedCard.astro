---
/**
 * FeaturedCard — numbered principle card for the three-up discovery
 * grid. Body is a slot so rich content (<code> chips, punctuation)
 * stays authored at the call site.
 */
interface Props {
  /** Zero-padded card number, e.g. "01". */
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<article class="featured-card">
  <div class="card-content">
    <h3>
      <span class="card-index">{index}</span>
      {title}
    </h3>
    <p><slot /></p>
  </div>
</article>
