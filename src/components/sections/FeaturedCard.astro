---
/**
 * FeaturedCard — numbered principle card for the three-up discovery
 * grid. Body is a slot so rich content (<code> chips, punctuation)
 * stays authored at the call site.
 */
interface Props {
  /** Zero-padded card number, e.g. "01". */
  index: string;
  title: string;
}

const { index, title } = Astro.props;
---

<article class="featured-card">
  <div class="card-content">
    <h3>
      <span class="card-index">{index}</span>
      {title}
    </h3>
    <p><slot /></p>
  </div>
</article>

<script>
  const initSpotlight = () => {
    const cards = document.querySelectorAll('.featured-card');
    
    cards.forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const rect = card.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        
        card.style.setProperty('--mouse-x', `${x}px`);
        card.style.setProperty('--mouse-y', `${y}px`);
      });
    });
  };

  // Run on initial load
  initSpotlight();
  
  // Support for Astro's view transitions if enabled
  document.addEventListener('astro:after-swap', initSpotlight);
</script>
