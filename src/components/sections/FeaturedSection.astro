---
/**
 * FeaturedSection — product capabilities discovery grid
 * (1 → 2 → 3 columns at 640px / 1024px, featured.css).
 */
import FeaturedCard from './FeaturedCard.astro';
---

<section class="featured-section" aria-labelledby="featured-title">
  <div class="container">
    <h2 id="featured-title" class="featured-header">Explore KOLINN_NAV</h2>
    <div class="featured-grid">
      <FeaturedCard index="01" title="Responsive navigation">
        Browse desktop mega-menu panels or the mobile accordion menu, with keyboard support
        and clear open and close states.
      </FeaturedCard>
      <FeaturedCard index="02" title="Searchable content">
        Find pages, news, guides, and project releases through the on-demand site search,
        with a browseable fallback on the search page.
      </FeaturedCard>
      <FeaturedCard index="03" title="Project releases">
        Read sample case studies for Apex Sentinel, Lumina UI Kit, and Nova Core Engine,
        with locally hosted preview artwork.
      </FeaturedCard>
    </div>
  </div>
</section>
