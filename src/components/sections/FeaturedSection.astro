---
/**
 * FeaturedSection — "Uncompromised" three-up content discovery grid
 * (1 → 2 → 3 columns at 640px / 1024px, featured.css).
 */
import FeaturedCard from './FeaturedCard.astro';
---

<section class="featured-section" aria-labelledby="featured-title">
  <div class="container">
    <h2 id="featured-title" class="featured-header">Uncompromised</h2>
    <div class="featured-grid">
      <FeaturedCard index="01" title="Performance">
        Zero dependencies. State is class-driven with exactly one layout read per interaction,
        a <code>ResizeObserver</code> keeps the flyout height truthful, and item animations
        stick to <code>transform</code> and <code>opacity</code> for a consistent 60fps.
      </FeaturedCard>
      <FeaturedCard index="02" title="Accessibility">
        Nord pairs re-tested for AA, <code>inert</code>-based focus containment, honest ARIA state
        (<code>aria-expanded</code> / <code>aria-controls</code>), <code>:focus-visible</code> detection,
        Escape with focus restoration, a skip link, and full <code>prefers-reduced-motion</code> respect.
      </FeaturedCard>
      <FeaturedCard index="03" title="Design engineering">
        Token-first: Nord primitives resolve through semantic roles, Fira Code prompts and
        Fira Sans prose sit on an 8px rhythm, and a frosted full-screen curtain spotlights
        the open flyout.
      </FeaturedCard>
    </div>
  </div>
</section>
