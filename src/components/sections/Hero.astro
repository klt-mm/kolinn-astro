---
/**
 * Hero — terminal-style opener with status, site summary and entry links.
 * `.shimmer-text` is a global utility (utilities.css) and calms down
 * under prefers-reduced-motion (a11y.css).
 */
import Badge from '../ui/Badge.astro';
import Button from '../ui/Button.astro';
import { site } from '../../config/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container">
    <p class="hero-command">$ kolinn init --nav <span aria-hidden="true">█</span></p>
    <Badge pulsing>System ready · {site.version}</Badge>
    <h1 id="hero-title">
      <span class="shimmer-text">Projects, guides, and design systems</span>
    </h1>
    <p class="hero-copy">
      Explore KOLINN_NAV: an Astro-powered site with responsive navigation,
      searchable documentation, project releases, and practical guides.
    </p>
    <div class="hero-actions">
      <Button href="/projects/releases" variant="primary">Explore projects</Button>
      <a class="hero-secondary-link" href="/blog/guides/quick-start">Read the quick start</a>
    </div>
    <div class="divider" aria-hidden="true">---</div>
    <p class="credit">Built with the KOLINN Design System.</p>
  </div>
</section>
