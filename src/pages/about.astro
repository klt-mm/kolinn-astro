---
/**
 * About — whoami: principles, system manifest, changelog timeline.
 * Demo data lives in src/data/about.ts.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import FeaturedCard from '../components/sections/FeaturedCard.astro';
import RelatedPosts from '../components/RelatedPosts.astro';
import { getCollection } from 'astro:content';
import { principles, manifest } from '../data/about';

const allPosts = await Promise.all([
  getCollection('news', ({ data }) => !data.draft).then(posts => posts.map(p => ({
    href: `/blog/news/${p.id}`,
    title: p.data.title,
    description: p.data.description,
    pubDate: p.data.pubDate,
    kind: 'news' as const,
    meta: p.data.category,
    body: p.body
  }))),
  getCollection('guides', ({ data }) => !data.draft).then(posts => posts.map(p => ({
    href: `/blog/guides/${p.id}`,
    title: p.data.title,
    description: p.data.description,
    pubDate: p.data.pubDate,
    kind: 'guide' as const,
    meta: p.data.level,
    body: p.body
  }))),
  getCollection('projects', ({ data }) => !data.draft).then(posts => posts.map(p => ({
    href: `/projects/${p.id}`,
    title: p.data.title,
    description: p.data.description,
    pubDate: p.data.pubDate,
    kind: 'news' as const,
    meta: p.data.techStack?.[0] || 'project',
    body: p.body
  }))),
]).then(results => results.flat());

const latestPosts = allPosts.sort((a, b) => b.pubDate.valueOf() - a.pubDate.valueOf()).slice(0, 3);
---

<BaseLayout
  title="About — KOLINN"
  description="Software Engineer specializing in robust, scalable applications and end-to-end digital solutions."
>
  <main id="main" tabindex="-1">
    <PageHeader
      command="$ kolinn whoami"
      title="About KOLINN"
      copy="Software Engineer from Myanmar with 5+ years of experience designing and scaling web services. Specializing in robust backend logic, automation, and high-quality software architecture."
    />

    <section class="page-section" id="principles" aria-labelledby="principles-title">
      <div class="container">
        <h2 id="principles-title" class="section-head">
          <span class="section-index">01</span> Core principles
        </h2>
        <div class="featured-grid">
          {
            principles.slice(0, 3).map((p) => (
              <FeaturedCard index={p.index} title={p.title}>{p.body}</FeaturedCard>
            ))
          }
        </div>
      </div>
    </section>

    <section class="page-section" id="manifest" aria-labelledby="manifest-title">
      <div class="container">
        <h2 id="manifest-title" class="section-head">
          <span class="section-index">02</span> System manifest
        </h2>
        <dl class="manifest">
          {
            manifest.map((entry) => (
              <div class="manifest-row">
                <dt>{entry.key}</dt>
                <dd>{entry.value}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <RelatedPosts title="Explore the blog" posts={latestPosts} />
  </main>
</BaseLayout>
