---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout title="404 — Page Not Found">
  <main id="main" class="error-container" tabindex="-1">
    <div class="error-content">
      <span class="error-code">404</span>
      <h1 class="error-title">Lost in the console</h1>
      <p class="error-message">
        The page you are looking for doesn't exist or has been moved to another directory.
      </p>
      <div class="error-actions">
        <Button href="/" variant="primary">Return Home</Button>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .error-container {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 70vh;
    text-align: center;
    padding: var(--kds-space-6) var(--kds-gutter);
  }

  .error-content {
    max-width: 48rem;
  }

  .error-code {
    display: block;
    font-family: var(--kds-font-mono);
    font-size: var(--kds-display-64);
    font-weight: 800;
    line-height: 1;
    color: var(--kds-action-primary);
    margin-bottom: var(--kds-space-2);
    opacity: 0.8;
  }

  .error-title {
    font-size: var(--kds-heading-48);
    line-height: var(--kds-lh-heading-48);
    font-weight: 700;
    color: var(--kds-text-primary);
    margin-bottom: var(--kds-space-3);
    letter-spacing: -0.02em;
  }

  .error-message {
    font-size: var(--kds-body-16);
    line-height: var(--kds-lh-body-16);
    color: var(--kds-text-muted);
    margin-bottom: var(--kds-space-6);
    max-width: 32rem;
    margin-inline: auto;
  }

  .error-actions {
    display: flex;
    justify-content: center;
    gap: var(--kds-space-2);
  }
</style>
