---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Button from '../../components/ui/Button.astro';
import { compareNewestFirst, isPublished } from '../../utils/content.js';
import '../../styles/components/projects.css';

const projects = await getCollection('projects', isPublished);
projects.sort(compareNewestFirst);
---

<BaseLayout
  title="Projects — KOLINN_NAV"
  description="A showcase of high-performance engineering and design system implementations."
>
  <main id="main" tabindex="-1">
    <PageHeader
      command="$ kolinn list --projects"
      title="Projects"
      copy="Exploring the intersection of performance, accessibility, and design engineering."
    />

    <section class="page-section">
      <div class="container">
        <div class="project-grid">
          {projects.map(project => (
            <article class="resource-card project-card">
              <div class="project-card-header">
                <h3>{project.data.title}</h3>
                <div class="project-card-tech">
                  {project.data.techStack.map(tech => (
                    <span class="tech-badge">{tech}</span>
                  ))}
                </div>
              </div>
              <p>{project.data.description}</p>
              <Button href={`/projects/releases/${project.id}`} variant="primary">View Project</Button>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
