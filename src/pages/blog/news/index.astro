---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import PostCard from '../../../components/PostCard.astro';
import { compareNewestFirst, isPublished } from '../../../utils/content.js';

const posts = await getCollection('news', isPublished);
posts.sort(compareNewestFirst);
---

<BaseLayout
  title="News — KOLINN_NAV"
  description="Product updates, release notes, and announcements from KOLINN_NAV."
>
  <main id="main" tabindex="-1">
    <PageHeader
      command="$ kolinn log --stream"
      title="News"
      copy="Release notes, product updates, and announcements."
    />
    <section class="page-section" aria-labelledby="news-list-title">
      <div class="container">
        <h2 class="section-head" id="news-list-title">Latest news</h2>
        <div class="post-grid">
          {posts.map((post) => (
            <PostCard
              href={`/blog/news/${post.id}`}
              kind="news"
              meta={post.data.category}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              body={post.body}
            />
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
